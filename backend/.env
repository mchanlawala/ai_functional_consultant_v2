# Ollama (only needed if using local embeddings)
OLLAMA_HOST=http://localhost:11434

# OpenAI settings
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini                   # fast & cheap

# Models for different components
TEXT_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1-mini
LLM_MODEL=gpt-4.1-mini

# Embeddings – use local (free) to avoid extra cost
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_MODEL=text-embedding-3-small   # OpenAI (costs, but faster)

WHISPER_MODEL=base
HOST=0.0.0.0
PORT=8000
